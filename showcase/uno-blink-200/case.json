  "files": {
   "sketch/sketch.ino": "// PlugAI project — Arduino Uno (ATmega328P).\n// Blink a red LED on D9: 100 ms ON / 100 ms OFF, period 200 ms, duty 50%.\n// Wiring: D9 -> 220 ohm resistor -> LED anode, LED cathode -> GND.\n// Current: (5 V - 1.9 V) / 220 ohm ~ 13 mA (safe, visible).\n\nconst uint8_t LED_PIN = 9;         // digital output driving the LED\nconst uint16_t HALF_PERIOD_MS = 100;  // ON time = OFF time = half of the 200 ms period\n\nvoid setup() {\n  Serial.begin(115200);\n  Serial.println(\"PlugAI: LED blink on D9, 100ms on / 100ms off (200ms period)\");\n\n  pinMode(LED_PIN, OUTPUT);\n  digitalWrite(LED_PIN, LOW);  // start with the LED off\n}\n\nvoid loop() {\n  digitalWrite(LED_PIN, HIGH);\n  delay(HALF_PERIOD_MS);\n  digitalWrite(LED_PIN, LOW);\n  delay(HALF_PERIOD_MS);\n}\n"
  },

{
  "name": "plugai",
  "version": "1.0.0",
  "private": true,
  "description": "PlugAI — AI Native Embedded Development Studio. Vibe Coding for the Physical World.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backends/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup/setup.sh",
    "doctor": "tsx scripts/probe/doctor.ts",
    "dev": "bash scripts/dev.sh",
    "start": "bash scripts/dev.sh",
    "dev:server": "tsx watch --clear-screen=false apps/server/src/index.ts",
    "dev:web": "npm --workspace @plugai/web run dev",
    "build:web": "npm --workspace @plugai/web run build",
    "build:site": "bash scripts/deploy/pages.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:p0": "tsx scripts/test/p0-acceptance.ts",
    "test:flash": "tsx scripts/test/virtual-flash.ts",
    "test:llm": "tsx scripts/test/llm-acceptance.ts",
    "test:e2e": "tsx scripts/test/e2e-final.ts",
    "test:all": "bash scripts/test/run-all.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "avr8js": "^0.21.1",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  }
}

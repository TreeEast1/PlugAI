# DeepSeek (OpenAI-compatible) — all model calls go through the backend only.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
# enabled | disabled
DEEPSEEK_THINKING=enabled
DEEPSEEK_TIMEOUT_MS=240000
DEEPSEEK_MAX_RETRIES=4
# Optional cost accounting (USD per 1M tokens). Leave empty to report tokens only.
DEEPSEEK_PRICE_INPUT_PER_M=
DEEPSEEK_PRICE_INPUT_CACHED_PER_M=
DEEPSEEK_PRICE_OUTPUT_PER_M=

# Toolchains
IDF_PATH=~/esp/esp-idf
IDF_TOOLS_PATH=~/.espressif
ARDUINO_CLI=arduino-cli
ESP_EMU_BIN=~/.local/bin/esp-emu

# Server
PLUGAI_PORT=8787
PLUGAI_DATA_DIR=./workspaces
